input {
    FP Horizontal;
    FP Vertical;
    button Jump;
    button Run;
    button Interact;
    button Reset;
}

global {
    int FlipFriendsCompletedFrame;
    bool FlipFriendsBoxesInitialized;
    bool FlipFriendsDevicesInitialized;
    bool FlipFriendsLaunchersInitialized;
    bool FlipFriendsMotionsInitialized;
    int FlipFriendsMotionStartedFrame;
    bool FlipFriendsCannonsInitialized;
    int FlipFriendsProjectileCount;
    int FlipFriendsProjectileSpawned;
    int FlipFriendsProjectileExpired;
    int FlipFriendsDroppedShots;
}

component FlipFriendsMotion {
    int ContentIndex;
    int ElapsedTicks;
    int Revision;
    int ReadyFrame;
    int Phase;
    int Cycle;
    int LastUpdateFrame;
    int BlockedTicks;
    bool Collidable;
    bool ResetPending;
    bool HasReturned;
    FP RotationSpeed;
    FP Angle;
    FPVector2 Position;
    FPVector2 Delta;
}

component FlipFriendsMotionReset {
    int ContentIndex;
    int Contacts;
}

component FlipFriendsStageSwitch {
    int ContentIndex;
    int Contacts;
    int ReadyFrame;
    bool Active;
}

component FlipFriendsConveyor {
    int ContentIndex;
    EntityRef Motion;
    int Cycle;
    int Revision;
    bool Clockwise;
}

component FlipFriendsCannon {
    int ContentIndex;
    int ShotCount;
    int LastShotFrame;
}

component FlipFriendsProjectile {
    int Cannon;
    int Shot;
    int SpawnFrame;
    FPVector2 Origin;
    FPVector2 Position;
    int HitCount;
}

component FlipFriendsPlayer {
    player_ref Player;
    FPVector2 HomePosition;
    bool HasCheckpoint;
    int CheckpointId;
    FPVector2 CheckpointPosition;
    FPVector2 RespawnPosition;
    bool SectionPending;
    int SectionCount;
    bool WasResetHeld;
    bool RespawnPending;
    int RespawnFrame;
    int RespawnCount;
    FPVector2 Velocity;
    FP VelocityXSmoothing;
    bool WasJumpHeld;
    bool IsGrounded;
    bool IsTouchingLeft;
    bool IsTouchingRight;
    bool IsTouchingCeiling;
    bool IsClimbed;
    int RopeContactCount;
    int ClimbBlockTicks;
    bool IsFinished;
    int FinishedFrame;
    FPVector2 PreviousPosition;
    EntityRef StompTarget;
    int JumpBlockTicks;
    int ShrinkTicks;
    int StompCount;
    int StompFrame;
    FP StompPushX;
    EntityRef Carrier;
    EntityRef Held;
    bool WasInteractHeld;
    int Facing;
    int ReleaseFrame;
    int EscapeFrame;
    int EscapeRequestFrame;
    int UncontrollableTicks;
    int PickupCount;
    int ThrowCount;
    int PutDownCount;
    int EscapeCount;
    int InvincibleTicks;
    int DamageCount;
    int DamageFrame;
    int LaunchCount;
    int LaunchFrame;
    int LaunchKind;
    FP ConveyorVelocityX;
    int ConveyorContact;
}

component FlipFriendsLauncher {
    int ContentIndex;
    int PlayerContacts;
}

component FlipFriendsBox {
    int ContentIndex;
    FPVector2 HomePosition;
    FPVector2 RespawnPosition;
    bool RespawnPending;
    int RespawnFrame;
    int RespawnCount;
    FPVector2 HalfSize;
    FPVector2 Velocity;
    FP VelocityXSmoothing;
    EntityRef Carrier;
    bool IsGrounded;
}

component FlipFriendsDevice {
    int ContentIndex;
    int PlayerContacts;
    ulong BoxContacts;
    int CooldownUntil;
    int LastSummonFrame;
    int SuccessCount;
    int FailureCount;
}
